# GridAssetLink Desktop local settings
# Copy to .env for development, or place .env in the app data directory for a packaged exe.

# Defaults to python_desktop_app/data in development and LOCALAPPDATA/GridAssetLinkDesktop when packaged.
# GRIDASSETLINK_DATA_DIR=C:\Users\you\AppData\Local\GridAssetLinkDesktop

# Defaults to GRIDASSETLINK_DATA_DIR/gridassetlink_demo.sqlite.
# GRIDASSETLINK_DB_PATH=C:\Users\you\AppData\Local\GridAssetLinkDesktop\gridassetlink_demo.sqlite

# Leave unset for offline SVG mode. Set false only if you add authorized external/offline tile support later.
GRIDASSETLINK_OFFLINE_MAP=true

# Optional future enterprise connection. The desktop MVP does not require PostGIS.
# Keep credentials out of source control.
# GRIDASSETLINK_POSTGIS_URL=postgresql+psycopg://user:password@host:5432/dbname

# Optional future AI assistant adapter. Do not hard-code API keys in source.
# OPENAI_API_KEY=

